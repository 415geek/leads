# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic（AI 分类层 + 开发信生成）
# 建议使用 claude-haiku-4 或更高级模型做批量分类（便宜），开发信生成沿用 sonnet
ANTHROPIC_API_KEY=
# 可选：覆盖分类模型（默认 'claude-haiku-4-5-20251001'）
ANTHROPIC_CLASSIFY_MODEL=
# 可选：老板信息「匹配关键字」交叉验证模型（默认 claude-sonnet-4-20250514）
ANTHROPIC_OWNER_MATCH_MODEL=

# 可选：详情页「刷新联网情报」Tavily 搜索；不配置则仅用结构化字段 + Claude
TAVILY_API_KEY=

# Whitepages Pro Person Search（仪表盘老板信息搜索；仅服务端，勿提交到 Git）
WHITEPAGES_PRO_API_KEY=

# People Data Labs Person Search（已弃用，保留供旧脚本参考）
PEOPLE_DATA_LABS_API_KEY=

# Google Places API（V1 enrichment 层；必须开启 Places API）
# 说明：每次 Text Search 约 $0.017；日预算上限由 GOOGLE_PLACES_DAILY_CAP 控制
GOOGLE_PLACES_API_KEY=
# 每个进程每日最多调用次数；达到上限后自动熔断，lead 仍入库但 enrichment=null
# 默认 3000（~$50/日）；预算紧张可调小
GOOGLE_PLACES_DAILY_CAP=3000

# 休斯顿多源抓取（优先级见 lib/houston-opening-intel.ts HOUSTON_SOURCE_MERGE_PRIORITY）
# 1 Permit Portal / CO — JSON 导出 + 规划局 eReport 自动回退
HOUSTON_PERMIT_PORTAL_JSON_URL=
# 2 Houston Health food permit
HOUSTON_HEALTH_FOOD_PERMIT_JSON_URL=
# 3 TABC — 默认 live Socrata；可选 JSON 回退
HOUSTON_TABC_JSON_URL=
# 4 Texas Comptroller sales tax permit
TX_COMPTROLLER_HOUSTON_JSON_URL=
# 5 Texas SOSDirect entity search（JSON 补充）
TX_SOS_HOUSTON_JSON_URL=
# 6 Harris County DBA
HARRIS_DBA_JSON_URL=
# 7 Houston OBO certified directory
HOUSTON_OBO_CERTIFIED_JSON_URL=
# 8 Open Data 批量补全（HDHHS CKAN — 见 HOUSTON_HDHHS_* 下方）
# HDHHS CKAN：覆盖默认 Last Facility Inspection resource UUID（门户发布新 datastore 时改这里，无需改代码）
HOUSTON_HDHHS_DATASTORE_RESOURCE_ID=
# HDHHS：单次 SQL 拉取上限，50–5000（默认 300）
HOUSTON_HDHHS_IMPORT_LIMIT=
# HDHHS：=1 时名称须含餐饮关键词或 facility 类型含 restaurant/cafe 等（默认关闭，仅去连锁）
HOUSTON_HDHHS_STRICT_NAME_KEYWORDS=

# 洛杉矶县餐饮检查导入策略（可选）
# new_facilities（默认）：仅「本数据集内该店首次检查日」落在 lookback 窗口内，近似新注册设施
# recent_inspections：任意近期检查活动（易产生老店复检假阳性）
LA_COUNTY_IMPORT_STRATEGY=
# 新设施模式下：单设施在季度表中的最大检查行数上限，超过则视为老店（默认 12）；0=不限制
LA_COUNTY_NEW_FACILITY_MAX_INSPECTION_ROWS=

# Socrata App Token（可选；SF/NYC/LA/Chicago/Seattle/Austin 数据门户用）
# 不填时受匿名限流（1000 req/h）；填了可免限流
SOCRATA_APP_TOKEN=

# NYC DOHMH：默认仅拉 Pre-permit 检查（新店线索）；=1 时含 Cycle 常规年检
NYC_INCLUDE_CYCLE_INSPECTIONS=

# Cron 保护密钥（Vercel Cron 触发 /api/cron/ingest-all 时在 Authorization: Bearer <此值> 里带）
CRON_SECRET=

# n8n Webhook 密钥（用于 POST /api/leads/upsert 与 POST /api/leads/filings/sync）
N8N_WEBHOOK_SECRET=

# Skip-trace / 证据链（dev-prompts P2–P3；默认关闭，不影响现网）
# SKIP_TRACE_PROVIDER=mock|batchdata
BATCHDATA_API_KEY=
# BATCHDATA_API_BASE_URL=https://api.batchdata.com
# 启用 POST /api/leads/cross-validate（需先在 Supabase 执行 lead_evidence 迁移）
# ENABLE_LEAD_EVIDENCE_CROSS_VALIDATE=1
# 启用 POST /api/property/lookup（地产证据 → lead_evidence）
# ENABLE_LEAD_PROPERTY_LOOKUP=1
# PROPERTY_PROVIDER=mock|attom
# ATTOM_API_KEY=
# ATTOM_API_BASE_URL=https://api.gateway.attomdata.com
# 启用 POST /api/leads/identify（经营主体/自然人 → lead_evidence + owner_* 列）
# ENABLE_LEAD_IDENTIFY=1
# 启用 POST /api/leads/enrich（skip-trace → lead_evidence；建议先 identify）
# ENABLE_LEAD_SKIP_TRACE_ENRICH=1
# 共享开业判定层（NYC/LA/Houston 信号标准化；默认关，关时与历史逻辑一致）
# ENABLE_LEAD_OPENING_INTEL=1
# identify 多源投票：仅 ≥2 源一致才写 owner_person_name
# ENABLE_LEAD_IDENTIFY_GATE=1

# API v1（公司/自动化接入，见 docs/API_V1.md）
# 请求头：Authorization: Bearer <key> 或 X-API-Key: <key>
API_V1_KEY=
# API_V1_KEYS=key-a,key-b

# 应用配置
NEXT_PUBLIC_APP_URL=https://leads.maxwelllai.com

# 登录（必填；密码勿提交到 Git，仅在 Vercel / .env.local 配置）
# AUTH_SECRET：至少 16 字符，可用 openssl rand -base64 32 生成
AUTH_SECRET=
AUTH_ALLOWED_EMAIL=geekyiot@gmail.com
AUTH_PASSWORD=
# 可选：更多账号，JSON 对象 {"邮箱":"明文密码"}，与上一行主账号合并（键名大小写不敏感）
# AUTH_USERS_JSON={"ops@example.com":"another-plain-password"}
AUTH_USERS_JSON=
