{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingest-all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "app/api/cron/ingest-all/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/digest/route.ts": {
      "maxDuration": 60
    },
    "app/api/leads/import/route.ts": {
      "maxDuration": 120
    }
  }
}
